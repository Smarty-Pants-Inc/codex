{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "NativeReservation": {
      "description": "Native capacity preconditions only; never external model/framing qualification.",
      "properties": {
        "generation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "maxFrameBytes": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "profile": {
          "$ref": "#/definitions/NativeReservationProfile"
        },
        "reservedTokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/definitions/NativeReservationState"
        },
        "usableContextTokens": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "generation",
        "maxFrameBytes",
        "profile",
        "reservedTokens",
        "state"
      ],
      "type": "object"
    },
    "NativeReservationProfile": {
      "enum": [
        "harmonyGptOss"
      ],
      "type": "string"
    },
    "NativeReservationState": {
      "enum": [
        "valid",
        "invalid",
        "unsupported"
      ],
      "type": "string"
    }
  },
  "properties": {
    "commitOrder": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "nativeReservation": {
      "$ref": "#/definitions/NativeReservation"
    },
    "ownerEpoch": {
      "type": "string"
    },
    "protocol": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    }
  },
  "required": [
    "commitOrder",
    "nativeReservation",
    "ownerEpoch",
    "protocol",
    "threadId"
  ],
  "title": "ThreadObservationBudgetNotification",
  "type": "object"
}